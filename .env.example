# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trove_db

# Auth - generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Environment
ENVIRONMENT=development

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for OAuth redirect after callback)
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated allowed origins (required in production)
CORS_ORIGINS=

# Cloud Storage — point local dev at the dev bucket, never the production one.
#
# No keys here: authentication is application default credentials, so run
#   gcloud auth application-default login
# once and the bucket is reachable as you. The public URL is derived from this
# name, so there is nothing else to set.
STORAGE_BUCKET_NAME=trove-images-dev

# Sentry — leave empty for local development.
#
# An empty DSN disables Sentry entirely: no SDK init, nothing sent. Verifying
# the integration locally means temporarily pasting the real DSN here, which is
# deliberately an act rather than a default, so test exceptions do not land in
# the production issue stream by accident.
#
# SENTRY_DSN=
